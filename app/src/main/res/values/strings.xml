    <!-- 传输方式 / USB -->
    <string name="smb_mode_title">连接方式</string>
    <string name="smb_mode_wifi">Wi-Fi SMB（NAS/路由器）</string>
    <string name="smb_mode_usb">USB 直连电脑</string>
    <string name="smb_mode_hotspot">热点（电脑连手机）</string>
    <string name="smb_mode_wifi_btn">Wi-Fi</string>
    <string name="smb_mode_usb_btn">USB</string>
    <string name="smb_mode_hotspot_btn">热点</string>
    <string name="usb_helper">USB 模式说明：\n1. 用数据线把手机连电脑；\n2. 手机上开启「USB网络共享」（不需要 USB 调试/ADB）；\n3. 在电脑上把目标文件夹设为共享（如 \\\\DESKTOP-XXX\\backup）；\n4. 下方“共享名/用户名/密码/远端目录”填电脑共享的信息；\n5. 电脑 IP 留空=自动检测，也可手动填写。</string>
    <string name="usb_host_manual">电脑 IP（可留空=自动检测）</string>
    <string name="usb_err_not_found">未检测到 USB 网络共享链路。\n请确认：数据线已连接、手机已开启“USB网络共享”（无需 ADB/USB 调试）、电脑已开机并共享了目标文件夹。也可在设置里手动填写电脑 IP。</string>
    <string name="usb_host_found">将连接电脑：%1$s</string>
    <string name="hotspot_host_manual">电脑 IP（可留空=自动探测热点网段）</string>
    <string name="hotspot_helper">热点模式说明（适合无法开启 USB 网络共享的环境，如鸿蒙卓易通）：\n1. 手机端开热点，电脑 Wi-Fi 连接手机热点；\n2. 电脑把目标文件夹设为共享，并记下电脑 IP（电脑上 ipconfig 查看，通常 192.168.43.x）；\n3. 下方“共享名/用户名/密码/远端目录”填电脑共享的信息；\n4. 电脑 IP 留空 = 自动探测热点网段的共享主机，也可手动填写（更可靠）；\n5. 需在电脑防火墙放行 SMB（445 端口，专用网络）。</string>
    <string name="hotspot_err_not_found">未找到电脑共享主机。\n请确认：手机热点已开启、电脑已连接手机热点、电脑上已共享目标文件夹并放行 445 端口；也可在设置里手动填写电脑 IP。</string>
    <string name="target_switch_hotspot_desc">当前共享设置不变，走手机热点直连电脑</string>

